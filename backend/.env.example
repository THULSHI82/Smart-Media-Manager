# Flask and frontend
SECRET_KEY=replace-with-a-long-random-value
JWT_SECRET_KEY=replace-with-a-different-long-random-value
FRONTEND_URL=http://localhost:5173
API_BASE_URL=http://localhost:5001
CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_MB=50
FLASK_DEBUG=false

# Local demo is immediately runnable. Supabase schema is supplied in supabase/schema.sql.
DATA_BACKEND=sqlite
AUTH_BACKEND=local
DATABASE_PATH=./data/smart_media.db

# Storage: local for development, cloudinary for dissertation deployment
STORAGE_BACKEND=local
LOCAL_UPLOAD_DIR=./uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Supabase / pgvector (used when DATA_BACKEND=supabase)
SUPABASE_URL=
SUPABASE_DB_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@[HOST]:6543/postgres
SUPABASE_KEY=
SUPABASE_SERVICE_KEY=

# Celery + Redis. Keep false for a simple local demo; set true after Redis is running.
USE_CELERY=false
REDIS_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=false
PROCESSING_SYNC=false

# Computer vision
AI_ENABLED=true
FACE_MODEL=Facenet512
FACE_DETECTOR=retinaface
FACE_COSINE_THRESHOLD=0.68
BLUR_THRESHOLD=100
DUPLICATE_HASH_DISTANCE=8
CLASSIFIER_BACKEND=heuristic
CLASSIFICATION_MODEL_PATH=
MAX_IMAGE_DIMENSION=2048
THUMBNAIL_DIMENSION=480
JPEG_QUALITY=85
SELFIE_MAX_DIMENSION=1024
EMBEDDING_RETENTION_DAYS=90
